# База данных — это рабочие данные сайта (записи клиентов, отзывы,
# настройки), а не код. Она должна жить только на хостинге и никогда
# не попадать в git — во-первых, это просто чужие персональные данные
# (имена, телефоны клиентов), во-вторых, в неё пишутся секретные ключи
# (OneSignal и т.п.) через панель управления → «Настройки».
data/database.sqlite
data/database.sqlite-journal
data/database.sqlite-wal
data/database.sqlite-shm

# Секретные ключи (OneSignal REST API Key и т.п.) — см. config.secrets.php.
# Реальный файл с ключами создаётся один раз вручную на хостинге и
# никогда не коммитится, коммитится только config.secrets.php.example.
config.secrets.php
